# Скопируй этот файл в .env (без .example) и заполни.
# .env никогда не коммитится (он уже в .gitignore) -- в нём секретный ключ.

# Выдаёт организатор. Общий ключ команды на время разработки (бюджет 500р/день).
ALFA_LLM_API_KEY=

# Базовый URL OpenAI-совместимого API, через который доступны разрешённые модели
# (Gemma 4 26B A4B, GLM-5.3-Flash, Qwen3.6 35B A3B, DeepSeek-V4.1-Flash,
# Qwen3-VL-30B-A3B-Instruct, Kimi-K2.6). Тоже выдаёт организатор.
ALFA_LLM_BASE_URL=

# Необязательно: если точные id моделей у провайдера отличаются от значений
# по умолчанию в call_llm.py -- переопредели здесь (имена организатор пришлёт
# в письме с доступом к ключу).
# ALFA_MODEL_CHEAP_CLASSIFY=gemma-4-26b-a4b
# ALFA_MODEL_BULK_RANK=qwen3.6-35b-a3b
# ALFA_MODEL_DEEP_LINKS=deepseek-v4.1-flash
# ALFA_MODEL_GENERATION=glm-5.3-flash
# ALFA_MODEL_SELF_CHECK=kimi-k2.6
# ALFA_MODEL_VISION=qwen3-vl-30b-a3b-instruct

# Если tesseract.exe не добавлен в PATH при установке (нужен для bank_rag.py OCR):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
